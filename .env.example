SGAI_API_KEY=
SGAI_BASE_URL=https://v2-api.scrapegraphai.com
NEXT_PUBLIC_APP_NAME=Triad3 Search

# Autenticação própria (server-only — nunca prefixe com NEXT_PUBLIC_).
# O banco é usado exclusivamente como Postgres: nenhum recurso de Auth do
# provedor é usado. Veja src/server/db/client.ts e src/server/auth/.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SESSION_COOKIE_NAME=triad3_session

# Neo — orquestrador conversacional (server-only — nunca prefixe com NEXT_PUBLIC_).
# Modelo fixo em código (src/server/neo/model.ts), nunca configurável por env var.
# Lida apenas em src/server/neo/client.ts; nunca aparece no frontend, logs ou erros.
OPENAI_API_KEY=

# Opcional — para habilitar testes reais, defina RUN_LIVE_TESTS=true
# e execute npm run test. Veja o README antes, pois esses testes consomem créditos.
# RUN_LIVE_TESTS=true

# Opcional — para habilitar os testes ao vivo do Neo (ferramentas fake, chamada real de
# LLM), defina RUN_NEO_LIVE_TESTS=true. Veja o README antes de habilitar.
# RUN_NEO_LIVE_TESTS=true
